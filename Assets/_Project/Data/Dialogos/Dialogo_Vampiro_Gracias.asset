  m_Script: {fileID: 11500000, guid: 90f8916ddf634f63bb96191132da18ad, type: 3}
  m_Name: Dialogo_Vampiro_Gracias
  m_EditorClassIdentifier: 
  defaultSpeaker: "Vampiro"
  lines:
  - speaker: "Vampiro"
    message: "Bendita oscuridad. Le debo una, caballero: ya se encendi\u00F3 su tercera runa."
  - speaker: "Vampiro"
    message: "Ll\u00E9veselo, este farol. Los sectores que siguen est\u00E1n a oscuras y yo, francamente, no lo necesito."
