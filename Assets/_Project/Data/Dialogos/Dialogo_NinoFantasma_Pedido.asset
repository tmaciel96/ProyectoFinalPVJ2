  m_Script: {fileID: 11500000, guid: 90f8916ddf634f63bb96191132da18ad, type: 3}
  m_Name: Dialogo_NinoFantasma_Pedido
  m_EditorClassIdentifier: 
  defaultSpeaker: "Ni\u00F1o Fantasma"
  lines:
  - speaker: "Ni\u00F1o Fantasma"
    message: "\u00BFVos sos el sepulturero? Yo me acuerdo de cuando jugaba entre estas tumbas..."
  - speaker: "Ni\u00F1o Fantasma"
    message: "Pero ahora hay espectros en las tumbas malditas y no me dejan acercarme."
  - speaker: "Ni\u00F1o Fantasma"
    message: "\u00BFLos pod\u00E9s echar? Son m\u00E1s fuertes que los zombis, ten\u00E9 cuidado."
