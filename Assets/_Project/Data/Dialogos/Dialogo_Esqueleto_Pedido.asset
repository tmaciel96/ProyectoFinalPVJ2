  m_Script: {fileID: 11500000, guid: 90f8916ddf634f63bb96191132da18ad, type: 3}
  m_Name: Dialogo_Esqueleto_Pedido
  m_EditorClassIdentifier: 
  defaultSpeaker: "Zombi Sepulturero"
  lines:
  - speaker: "Zombi Sepulturero"
    message: "\u00A1Colega! Qu\u00E9 alegr\u00EDa ver a otro sepulturero. Yo cuidaba este cementerio antes que vos... bueno, antes de quedar as\u00ED."
  - speaker: "Zombi Sepulturero"
    message: "Unos zombis se metieron en mi parcela y no dejan dormir a nadie. S\u00ED, yo tambi\u00E9n soy uno, pero tengo modales. Son flojitos, pero son muchos."
  - speaker: "Zombi Sepulturero"
    message: "\u00BFMe ayud\u00E1s a sacarlos con esa pala? Yo te aliento desde ac\u00E1."
