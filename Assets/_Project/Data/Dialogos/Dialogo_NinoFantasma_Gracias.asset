  defaultSpeaker: "Ni\u00F1o Fantasma"
  lines:
  - speaker: "Ni\u00F1o Fantasma"
    message: "Gracias, se\u00F1or sepulturero. Ahora puedo volver a jugar tranquilo. \u00A1Mir\u00E1, la cuarta runa!"
  - speaker: "Ni\u00F1o Fantasma"
    message: "El Gato Negro te espera en el \u00FAltimo sector. Es medio arisco, pero es bueno."
