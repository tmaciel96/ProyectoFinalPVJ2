  m_Script: {fileID: 11500000, guid: 90f8916ddf634f63bb96191132da18ad, type: 3}
  m_Name: Dialogo_Bruja_Pedido
  m_EditorClassIdentifier: 
  defaultSpeaker: "Bruja"
  lines:
  - speaker: "Bruja"
    message: "\u00A1Ay, justo vos! Tengo el caldero hirviendo y me faltan tres ingredientes."
  - speaker: "Bruja"
    message: "Un hongo luminoso, una mano cortada y mi libro del ojo. Andan desparramados por este sector."
  - speaker: "Bruja"
    message: "Tra\u00E9melos y los echamos al caldero. A cambio te enciendo la primera runa, prometido."
