  m_EditorClassIdentifier: Assembly-CSharp::IntroDialogue
  introData: {fileID: 0}
  dialogueLines:
  - speaker: "Esp\xEDritu Ancestral"
    message: "Despierta, Guardi\xE1n de la Calabaza... La maldici\xF3n de la noche
      de brujas ha ca\xEDdo sobre el cementerio."
  - speaker: "Esp\xEDritu Ancestral"
    message: "Los fuegos fatuos y sombras rondan la niebla. Debes purificar los 3
      Altares Ancestrales con tu fuego r\xFAnico."
  - speaker: "Esp\xEDritu Ancestral"
    message: "Tienes hasta las 3:33 para escapar por el portal... Si el reloj marca
      la Hora de las Brujas, tu alma quedar\xE1 atrapada para siempre."
  dialoguePanel: {fileID: 1032404030}
